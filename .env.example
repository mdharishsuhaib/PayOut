# PayPal sandbox app: https://developer.paypal.com/dashboard/applications/sandbox
# The app needs the "Payouts" feature enabled. Leave empty to run in labelled simulation.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook ID from the dashboard (subscribe to Payouts batch + item events). Enables signature verification.
PAYPAL_WEBHOOK_ID=
# Log in with PayPal: enable it for the same app (Dashboard > Apps > your app > Features > Log in with PayPal),
# tick "Full name" and "Email", and add this exact Return URL there. Defaults to http://localhost:3100/auth/paypal/callback
PAYPAL_RETURN_URL=

# Country of the PayPal business account that sends payouts (must be a sending country, e.g. US)
SENDER_COUNTRY=US
# A sandbox PERSONAL account email (Dashboard > Testing tools > Sandbox accounts). Used by the sample batch
# so one payout really succeeds; the example.com addresses stay UNCLAIMED, which demonstrates recovery.
SANDBOX_RECEIVER_EMAIL=

# AI model: Ollama Cloud (create a key at https://ollama.com/settings/keys)
AI_API_KEY=
AI_BASE_URL=https://ollama.com/v1
AI_MODEL=gpt-oss:120b
# Fallback when the model is unavailable: Tavily search over PayPal's own docs (https://app.tavily.com)
TAVILY_API_KEY=

# Operator policy (not a PayPal rule): USD payouts at or above this need review
REVIEW_AMOUNT=2500
PORT=3100
