{
  // PayOut frontend on Cloudflare Workers. Deploy from this folder with: npx wrangler deploy
  "name": "payout",
  "main": "./worker.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/vendor/*", "/healthz"]
  },
  "vars": {
    // The PayOut server on Render (Dashboard > your service > the URL at the top). No trailing slash.
    "BACKEND_URL": "https://payout-api-b86t.onrender.com"
  },
  "observability": { "enabled": true }
}
